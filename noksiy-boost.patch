+    /// а при истечении времени взводим флаг `stop`, который уже не сбрасывается.
+    #[inline]
+    fn poll(&mut self) -> bool {
+        if self.stop {
+            return true;
+        }
+        if self.nodes & 2047 == 0 {
+            if let Some(limit) = self.time_limit {
+                if self.start_time.elapsed() >= limit {
+                    self.stop = true;
+                }
+            }
+        }
+        self.stop
